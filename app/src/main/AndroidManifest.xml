<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:name=".games.script.GameApplication" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:label="A2UI Chat"
        android:icon="@drawable/ic_launcher" android:supportsRtl="true"
        android:theme="@style/Theme.A2UIChat" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".games.script.GameSandboxService" android:exported="false"
            android:isolatedProcess="true" android:process=":game_sandbox" android:stopWithTask="true" />
    </application>
</manifest>
